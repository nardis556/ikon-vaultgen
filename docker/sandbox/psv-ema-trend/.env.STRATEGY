# ── PSV EMA 50/200 Trend on SANDBOX — guarded (PSV not deployed on sandbox) ──
# Provisioning refuses here until the Profit-Share provider ships on sandbox. When it does, set
# VAULT_PROVIDER below to the live sandbox PSV provider (from GET /exchange
# vaults.profitShareVaultProviderV1ContractAddress) and remove the ZeroAddress placeholder.
STRATEGY=psv-ema-trend
VAULT_TYPE=PSV
INSTANCE=sandbox
VAULT_PROVIDER=0x0000000000000000000000000000000000000000

EXECUTE=0
FRESH_WALLETS=1
GENERATE_WALLETS=1
DEPOSITOR_POOL_SIZE=10
SET_DETAILS=1
SETTLE_MS=15000
TICK_SECONDS=30
TIME_SCALE=1
SEED_POSITIONS=2
