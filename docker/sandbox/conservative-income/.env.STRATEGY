# ── Conservative Income (over-collateralized) ────────────────────────
# Committed: contains no secrets. Vault economics live in
# strategies/01-conservative-income.json — edit that to change them.
STRATEGY=conservative-income

# Bump to provision a SECOND, independent vault of this same strategy.
INSTANCE=1

# Safety: DRY-RUN unless 1. The dry run performs every read and check
# (protocol drift, strategy bounds, funding budget) and sends nothing.
EXECUTE=0

# Mint manager/depositor wallets on first run, persisted to the mounted
# .env.MANAGER / .env.DEPOSITORS. Set 0 once provisioned.
GENERATE_WALLETS=1

# Depositor pool size. Larger than the strategy's depositors.count (10)
# means the churn daemon can bring NEW depositors in over time rather than only
# recycling the original cohort. 0 = same as depositors.count.
DEPOSITOR_POOL_SIZE=16

# Push name + description via the authenticated setVaultDetails endpoint.
# Credentials come from .env.MANAGER fields 3 and 4:
#   MANAGER=address,privateKey,apiKey,apiSecret
# Deliberately NOT here, so this file stays secret-free and committable.
SET_DETAILS=1

# Seconds to let a freshly created vault settle before the first deposit.
# Too short and the deposit ComposeFails into the depositor's exchange balance.
SETTLE_MS=15000

# ── animate (MODE=animate) ───────────────────────────────────────────────────
# Blank = use the strategy file's setting. 1/0 to force.
CHURN_ENABLED=
MM_ENABLED=

# Daemon poll interval. Churn schedules are per-wallet and multi-hour, so this
# only bounds how promptly a due action fires.
TICK_SECONDS=30

# Compress the churn clock for demos: 0.001 replays a 24h schedule in ~86s.
# Scales the SCHEDULE only — interest still accrues in real time. 1 = real time.
TIME_SCALE=1

# Open this many real positions on the first market-making cycle (1-3).
# The resting ladder is post-only and becomes a position only when someone crosses
# it, which on a quiet market may be never — a vault showing zero positions looks
# dead. It also makes the inventory skew visible: a flat book quotes symmetrically.
SEED_POSITIONS=2
