# ── Shared sandbox connection + funding ──────────────────────────────────────
# Copy to .env.sandbox (gitignored) and fill in FUNDING_WALLET_KEY.
# Every strategy deployment references this ONE file, so the funding key lives in
# a single place rather than being duplicated into six per-strategy env files.
#
# Addresses verified live via GET /exchange on sandbox.
BASE_URL=https://api-perps-sandbox.katana.network/v1
CHAIN_ID=737373
SANDBOX=true
RPC_URL=https://rpc-bokuto.katanarpc.com/

EXCHANGE_CONTRACT=0x92d3072dDe1aD3e9B7895500F504aA5e664E71d3
VAULT_PROVIDER=0x9304FEeCa70694B5d9BeFEB5577EF6182f158CeB
LOCAL_DEPOSIT_ADAPTER=0x65b9a7F10C0C984dB118435FA974eA80a5896ee7
QUOTE_TOKEN=0xc2a4C310F2512A17Ac0047cf871aCAed3E62bB4B
LZ_ENDPOINT_ID=40448

# Funding wallet — seeds every manager + depositor. Needs vbUSDC and a little ETH.
# The loadgen's sandbox funding wallet works: same chain, same vbUSDC token.
FUNDING_WALLET_KEY=

# Per-wallet gas. Bokuto gas is ~0.00001/tx, so these are already generous.
MGR_ETH=0.004
DEP_ETH=0.002
