# ── Market Making ────────────────────────
# Committed: no secrets. Vault economics live in
# strategies/05-market-making-desk.json.
STRATEGY=market-making

# Demo runs its own instance so its wallets never collide with the sandbox set's.
INSTANCE=demo

EXECUTE=0
GENERATE_WALLETS=1

# Larger pool than the 10 initial depositors, so the churn daemon can bring new
# depositors in during the demo window rather than only recycling the same ten.
DEPOSITOR_POOL_SIZE=18

SET_DETAILS=1
SETTLE_MS=15000

CHURN_ENABLED=1
MM_ENABLED=1

# Quote refresh is driven by the strategy's marketMaking.refreshSeconds (30s);
# this only bounds how promptly a due churn action fires.
TICK_SECONDS=20

# Real depositor cadence is 24-48h, which shows nothing on a 30-minute call.
# 0.01 replays a day in ~15 minutes, so a viewer sees joins, top-ups and
# withdrawals actually happen. Set 1 for a realistic long-running demo.
# Scales the SCHEDULE only — interest still accrues in real time.
TIME_SCALE=0.01

# Open this many real positions on the first market-making cycle (1-3).
# The resting ladder is post-only and becomes a position only when someone crosses
# it, which on a quiet market may be never — a vault showing zero positions looks
# dead. It also makes the inventory skew visible: a flat book quotes symmetrically.
SEED_POSITIONS=2
