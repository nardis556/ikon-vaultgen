# ── Staging connection + funding ─────────────────────────────────────────────
# Verified live via GET /exchange on staging.
BASE_URL=https://api-staging.katana-perps-dev.com/v1
CHAIN_ID=737373
SANDBOX=true
RPC_URL=https://rpc-bokuto.katanarpc.com/

EXCHANGE_CONTRACT=0x4C234fCeA3f8c4C8a7D962a6d8f2214f6ab1D5c4
VAULT_PROVIDER=0x85Ea9016acdEc997338F92B3E1256E9ae4aC9411
LOCAL_DEPOSIT_ADAPTER=0xE827DABDE1A661AaE17bD4c18f9afA9bbb1aAfB8
QUOTE_TOKEN=0xc2a4C310F2512A17Ac0047cf871aCAed3E62bB4B
LZ_ENDPOINT_ID=40448

# Same wallet as sandbox — staging is the SAME chain (737373) and the SAME vbUSDC,
# only the exchange and vault provider differ.
FUNDING_WALLET_KEY=

# Same derivation as sandbox, but INSTANCE=staging gives every strategy a distinct
# BIP-44 account, so staging wallets never collide with the sandbox set.
POOL_MNEMONIC=

MGR_ETH=0.004
DEP_ETH=0.002

# Staging-scoped API credentials (the sandbox ones do not authenticate here).
MANAGER_API_KEY=
MANAGER_API_SECRET=
DEPOSITOR_API_KEY=
DEPOSITOR_API_SECRET=

# Conduit RPC access key — lifts the public endpoint rate limit.
RPC_ACCESS_KEY=
