STRATEGY=gold-trend

# Vault product. PSV (Profit-Share) is not deployed on this env yet, so FIV only.
VAULT_TYPE=FIV
INSTANCE=staging-2
EXECUTE=0
GENERATE_WALLETS=1
# Resume the same vault across runs (the default). Set 1 for a brand-new throwaway vault each run.
FRESH_WALLETS=0
DEPOSITOR_POOL_SIZE=16
SET_DETAILS=1
SETTLE_MS=15000
CHURN_ENABLED=
MM_ENABLED=
TICK_SECONDS=30
TIME_SCALE=1
SEED_POSITIONS=1
