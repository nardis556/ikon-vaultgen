# ── Demo deployment: sandbox chain, market-making vault only ─────────────────
# Copy to .env.demo (gitignored) and fill in the two secrets below.
#
# Kept separate from docker/sandbox/ on purpose: the demo runs its OWN vault with
# its OWN wallets, so rehearsing or resetting it never disturbs the six-strategy
# sandbox set (and vice versa).
BASE_URL=https://api-perps-sandbox.katana.network/v1
CHAIN_ID=737373
SANDBOX=true
RPC_URL=https://rpc-bokuto.katanarpc.com/

EXCHANGE_CONTRACT=0x92d3072dDe1aD3e9B7895500F504aA5e664E71d3
VAULT_PROVIDER=0x9304FEeCa70694B5d9BeFEB5577EF6182f158CeB
LOCAL_DEPOSIT_ADAPTER=0x65b9a7F10C0C984dB118435FA974eA80a5896ee7
QUOTE_TOKEN=0xc2a4C310F2512A17Ac0047cf871aCAed3E62bB4B
LZ_ENDPOINT_ID=40448

# Funding wallet — seeds the manager and the depositor pool.
FUNDING_WALLET_KEY=

# BIP-39 phrase making the demo's manager + depositor pool DETERMINISTIC, so the
# same addresses come back every time and can be pre-funded once with MODE=fund.
# Back this up: lose it and the demo wallets (and anything in them) are gone.
# Generate one with:  node -e "console.log(require('ethers').Wallet.createRandom().mnemonic.phrase)"
POOL_MNEMONIC=

MGR_ETH=0.004
DEP_ETH=0.002

# ── API credentials ──────────────────────────────────────────────────────────
# An API key identifies an ACCOUNT, not a wallet: any number of wallets can be
# associated into one account and each keeps its own balances and positions. So
# ONE key covers every manager and a second covers the whole depositor pool —
# you do not need a key per wallet.
#
# The manager needs credentials for setVaultDetails and market-making orders.
# Depositors need them only to WITHDRAW; deposits are pure on-chain approve+deposit.
#
# `MODE=associate` registers each wallet with the exchange and stamps these into
# .env.MANAGER / .env.DEPOSITORS. A wallet must be associated before the exchange
# will surface a balance for it.
MANAGER_API_KEY=
MANAGER_API_SECRET=
DEPOSITOR_API_KEY=
DEPOSITOR_API_SECRET=
