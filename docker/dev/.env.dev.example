# ── Dev (test-dev) connection + funding ──────────────────────────────────────
# Verified live via GET /exchange on dev. Dev is the ONLY environment where the
# Profit-Share Vault provider is deployed today, so PSV strategies run here.
BASE_URL=https://api-dev.katana-perps-dev.com/v1
CHAIN_ID=737373
SANDBOX=true
RPC_URL=https://rpc-bokuto.katanarpc.com/

EXCHANGE_CONTRACT=0x18F7966C93C5b5d24Dbc7a1425FCe6cf5ebAa5e0
# VAULT_PROVIDER is the ACTIVE provider for VAULT_TYPE. Each strategy's .env.STRATEGY
# sets VAULT_TYPE; set VAULT_PROVIDER here to match, or override it per strategy dir.
#   FIV: 0x46b4C417FFf61d14A6c398A04008d3eF65217E33
#   PSV: 0xC2AbBCB48561F34CfAc8E54F56d183eF7D94dD3f
VAULT_PROVIDER=0x46b4C417FFf61d14A6c398A04008d3eF65217E33
# Documented for reference; a PSV strategy dir overrides VAULT_PROVIDER with this.
PSV_VAULT_PROVIDER=0xC2AbBCB48561F34CfAc8E54F56d183eF7D94dD3f
LOCAL_DEPOSIT_ADAPTER=0x4Ef81360dE00B9f1f32847404C0D036FC6860F92
QUOTE_TOKEN=0xc2a4C310F2512A17Ac0047cf871aCAed3E62bB4B
LZ_ENDPOINT_ID=40448

# Dev is the SAME chain (737373) and SAME vbUSDC as staging/sandbox — the funding
# wallet is shareable. Fund a wallet with vbUSDC + ETH on Bokuto and put its key here.
FUNDING_WALLET_KEY=

# Deterministic pool (optional). Unset = random wallets funded just-in-time, which
# is what FRESH_WALLETS mode uses. INSTANCE=dev keeps dev wallets distinct.
POOL_MNEMONIC=

MGR_ETH=0.004
DEP_ETH=0.002

# Shared API credentials. One key identifies an ACCOUNT and is reusable across every
# manager / depositor (including every fresh-per-run wallet). Dev-scoped.
MANAGER_API_KEY=
MANAGER_API_SECRET=
DEPOSITOR_API_KEY=
DEPOSITOR_API_SECRET=

# Conduit RPC access key — lifts the public endpoint rate limit.
RPC_ACCESS_KEY=
