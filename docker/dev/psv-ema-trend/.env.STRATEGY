# ── PSV EMA 50/200 Trend (Profit-Share Vault) on DEV ────────────────────────
# Committed: contains no secrets. Vault economics live in strategies/08-psv-ema-trend.json.
# PSV is deployed on DEV only — provisioning this on staging/sandbox refuses (ZeroAddress).
STRATEGY=psv-ema-trend
VAULT_TYPE=PSV
INSTANCE=dev

# Override the env-level FIV provider with the dev Profit-Share provider.
VAULT_PROVIDER=0x7C7309595d98f04339c87e4aA09CBaF490FA7142

# DRY-RUN unless 1.
EXECUTE=0

# Fresh-per-run: mint BRAND-NEW manager + depositor wallets each run, fund them from the shared
# funding wallet, reuse the shared API keys (MANAGER_API_KEY / DEPOSITOR_API_KEY in .env.dev), and
# persist nothing. Each provision creates a new throwaway PSV vault. Set 0 (and restore the wallet
# mounts in compose.yml) for a persistent, resumable, animatable vault.
FRESH_WALLETS=1
GENERATE_WALLETS=1

DEPOSITOR_POOL_SIZE=10
SET_DETAILS=1
SETTLE_MS=15000

# ── animate (only used with FRESH_WALLETS=0) ────────────────────────────────
CHURN_ENABLED=
MM_ENABLED=
TICK_SECONDS=30
TIME_SCALE=1
SEED_POSITIONS=2
