# ── PSV RSI-2 Pullback (Profit-Share Vault) on DEV ─────────────────────────────────────
# Committed: contains no secrets. Vault economics live in strategies/09-psv-rsi-pullback.json.
STRATEGY=psv-rsi-pullback
VAULT_TYPE=PSV
INSTANCE=dev
# The Profit-Share provider (dev is the only env where it is deployed).
VAULT_PROVIDER=0xC2AbBCB48561F34CfAc8E54F56d183eF7D94dD3f

# DRY-RUN unless 1. The dry run performs every read + check and sends nothing.
EXECUTE=0

# Mint manager/depositor wallets on first run, persisted to the mounted files. Set 0 once provisioned.
GENERATE_WALLETS=1
# Resume the same vault across runs (the default). Set 1 for a brand-new throwaway vault each run.
FRESH_WALLETS=0

DEPOSITOR_POOL_SIZE=16
SET_DETAILS=1
SETTLE_MS=15000

# ── animate ─────────────────────────────────────────────────────────────────
CHURN_ENABLED=
MM_ENABLED=
TICK_SECONDS=30
TIME_SCALE=1
SEED_POSITIONS=2
