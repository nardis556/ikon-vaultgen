# ── EMA 50/200 Trend (Fixed-Income Vault) on DEV ────────────────────────────
# Committed: contains no secrets. Vault economics live in strategies/01-ema-trend.json.
STRATEGY=bollinger-fade
VAULT_TYPE=FIV
INSTANCE=dev

# DRY-RUN unless 1. The dry run performs every read + check and sends nothing.
EXECUTE=0

# Mint manager/depositor wallets on first run, persisted to the mounted files. Set 0 once provisioned.
GENERATE_WALLETS=1
# Resume the same vault across runs (the default). Set 1 for a brand-new throwaway vault each run.
FRESH_WALLETS=0

DEPOSITOR_POOL_SIZE=16
SET_DETAILS=1
SETTLE_MS=15000

# ── animate ─────────────────────────────────────────────────────────────────
CHURN_ENABLED=
MM_ENABLED=
TICK_SECONDS=30
TIME_SCALE=1
SEED_POSITIONS=2

# Retired 2026-10-21: this vault lives on the pre-2026-10-20 FIV provider (../.env.dev now names the new one).
VAULT_PROVIDER=0x46b4C417FFf61d14A6c398A04008d3eF65217E33
